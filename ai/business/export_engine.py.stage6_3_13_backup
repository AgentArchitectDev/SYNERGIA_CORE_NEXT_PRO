from pathlib import Path
import json
import zipfile
from datetime import datetime


print("[EXPORT ENGINE LOADED]")


# =========================================================
# CREATE MANIFEST
# =========================================================

def create_manifest(project_path):

    project = Path(project_path)

    files = []

    for file in project.rglob("*"):

        if file.is_file():

            files.append(
                str(
                    file.relative_to(project)
                )
            )


    manifest = {

        "project": project.name,

        "created":

            datetime.now().isoformat(),

        "files": files,

        "total_files": len(files),

        "status": "ready"

    }


    manifest_file = project / "manifest.json"


    with open(
        manifest_file,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            manifest,
            f,
            indent=2,
            ensure_ascii=False
        )


    return manifest_file



# =========================================================
# EXPORT PROJECT ZIP
# =========================================================

def export_project(project_path):


    project = Path(project_path)


    if not project.exists():

        return {

            "status": "error",

            "message":
            "Project not found"

        }



    print(
        f"\n[EXPORT PROJECT]\n{project}"
    )


    manifest = create_manifest(
        project
    )


    zip_file = (

        project.parent /

        f"{project.name}.zip"

    )


    with zipfile.ZipFile(

        zip_file,

        "w",

        zipfile.ZIP_DEFLATED

    ) as archive:


        for file in project.rglob("*"):

            if file.is_file():

                archive.write(

                    file,

                    file.relative_to(
                        project.parent
                    )

                )



    result = {

        "status": "completed",

        "project":

            project.name,

        "zip":

            str(zip_file),

        "manifest":

            str(manifest)

    }


    print(
        "\n[EXPORT COMPLETED]"
    )

    print(result)


    return result
