from datetime import datetime


from ai.business.business_progress import (
    BusinessProgress
)


from ai.business.business_generator import (
    create_business_project
)


from ai.business.business_validator import (
    validate_project
)


from ai.business.business_manager import (
    register_project
)


from ai.business.export_engine import (
    export_project
)


# =========================================================
# SYNERGIA BUSINESS ORCHESTRATOR
# STAGE 6.3.15
#
# Central coordination layer
# Progress integration
# =========================================================


print("[BUSINESS ORCHESTRATOR LOADED]")


# =========================================================
# RUN BUSINESS PIPELINE
# =========================================================


def run_business_pipeline(

    prompt

):


    started_at = (
        datetime.now()
    )


    progress = (
        BusinessProgress()
    )


    print()

    print(
        "========================================"
    )

    print(
        "[BUSINESS ORCHESTRATOR START]"
    )

    print(
        "========================================"
    )


    print()

    print(
        "[PROMPT]"
    )

    print(
        prompt
    )


    progress.update(

        10,

        "STARTING BUSINESS GENERATOR"

    )


    # =====================================================
    # GENERATION
    # =====================================================


    print()

    print(
        "[ORCHESTRATOR] "
        "STARTING BUSINESS GENERATOR"
    )


    generation = (

        create_business_project(

            prompt

        )

    )


    project_path = (

        generation[
            "project"
        ]

    )


    progress.update(

        90,

        "BUSINESS CONTENT GENERATED"

    )


    # =====================================================
    # VALIDATION
    # =====================================================


    progress.update(

        95,

        "VALIDATING PROJECT"

    )


    print()

    print(
        "[ORCHESTRATOR] "
        "STARTING VALIDATION"
    )


    validation = (

        validate_project(

            project_path

        )

    )


    # =====================================================
    # REGISTRATION
    # =====================================================


    progress.update(

        97,

        "REGISTERING PROJECT"

    )


    print()

    print(
        "[ORCHESTRATOR] "
        "REGISTERING PROJECT"
    )


    registration = (

        register_project(

            project_path,

            status=(
                validation[
                    "status"
                ]
            ),

            score=(
                validation[
                    "score"
                ]
            )

        )

    )


    # =====================================================
    # EXPORT
    # =====================================================


    progress.update(

        99,

        "EXPORTING PROJECT"

    )


    print()

    print(
        "[ORCHESTRATOR] "
        "EXPORTING PROJECT"
    )


    export = (

        export_project(

            project_path

        )

    )


    # =====================================================
    # FINAL STATUS
    # =====================================================


    final_status = (

        validation[
            "status"
        ]

    )


    if final_status == "VALID":

        final_stage = (

            "PROJECT COMPLETED"

        )


    else:

        final_stage = (

            "PROJECT FINISHED "
            "WITH VALIDATION ISSUES"

        )


    progress.complete(

        final_stage

    )


    finished_at = (

        datetime.now()

    )


    result = {

        "status":
            final_status,

        "project":
            project_path,

        "score":
            validation[
                "score"
            ],

        "generation":
            generation,

        "validation":
            validation,

        "registration":
            registration,

        "export":
            export,

        "progress":
            progress
            .get_status(),

        "stages": {

            "GENERATION":
                "COMPLETED",

            "VALIDATION":
                validation[
                    "status"
                ],

            "REGISTRATION":
                "VALID",

            "EXPORT":
                export.get(
                    "status",
                    "UNKNOWN"
                )

        },

        "started_at":
            started_at
            .isoformat(),

        "finished_at":
            finished_at
            .isoformat()

    }


    print()

    print(
        "========================================"
    )

    print(
        "[BUSINESS ORCHESTRATOR FINISHED]"
    )

    print(
        "========================================"
    )


    print()

    print(
        "STATUS:",
        result[
            "status"
        ]
    )


    print(
        "PROJECT:",
        result[
            "project"
        ]
    )


    print(
        "SCORE:",
        result[
            "score"
        ]
    )


    print(
        "PROGRESS:",
        result[
            "progress"
        ][
            "percent"
        ],
        "%"
    )


    return result
