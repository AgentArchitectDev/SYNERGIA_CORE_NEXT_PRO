from datetime import datetime


print("[BUSINESS ORCHESTRATOR LOADED]")


# =========================================================
# SYNERGIA BUSINESS ORCHESTRATOR
# STAGE 6.3.14.2
#
# Central Business Pipeline Coordinator
# =========================================================


from ai.business.business_generator import (
    create_business_project
)

from ai.business.business_validator import (
    validate_project
)

from ai.business.business_manager import (
    register_project
)

from ai.business.export_engine import (
    export_project
)



# =========================================================
# FULL PIPELINE
# =========================================================


def run_business_pipeline(

    prompt

):


    print()

    print("==============================")
    print("[BUSINESS ORCHESTRATOR START]")
    print("==============================")


    result = {

        "status": "RUNNING",

        "prompt": prompt,

        "stages": {},

        "started_at":
            datetime.now()
            .isoformat()

    }



    # =====================================================
    # GENERATE
    # =====================================================


    print()

    print("[STAGE] BUSINESS GENERATION")


    project_path = create_business_project(

        prompt

    )


    result["stages"]["generation"] = {

        "status": "completed",

        "project":
            str(project_path)

    }



    # =====================================================
    # VALIDATE
    # =====================================================


    print()

    print("[STAGE] VALIDATION")


    validation = validate_project(

        project_path

    )


    result["stages"]["validation"] = validation



    # =====================================================
    # REGISTER
    # =====================================================


    print()

    print("[STAGE] REGISTRATION")


    register_project(

        project_path,

        status=validation["status"],

        score=validation["score"]

    )


    result["stages"]["manager"] = {

        "status": "registered"

    }



    # =====================================================
    # EXPORT
    # =====================================================


    print()

    print("[STAGE] EXPORT")


    export = export_project(

        project_path

    )


    result["stages"]["export"] = export



    # =====================================================
    # FINISH
    # =====================================================


    result["status"] = "COMPLETED"


    result["finished_at"] = (

        datetime.now()
        .isoformat()

    )


    print()

    print("==============================")
    print("[BUSINESS ORCHESTRATOR FINISHED]")
    print("==============================")


    return result

