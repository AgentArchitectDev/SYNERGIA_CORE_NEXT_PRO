from datetime import datetime


# =========================================================
# SYNERGIA BUSINESS ORCHESTRATOR
# STAGE 6.3.14.2
#
# Full Business Pipeline Integration
# =========================================================


print("[BUSINESS ORCHESTRATOR LOADED]")


# =========================================================
# IMPORTS
# =========================================================


from ai.business.business_generator import (
    create_business_project
)


from ai.business.business_validator import (
    validate_project
)


from ai.business.business_manager import (
    register_project
)


from ai.business.export_engine import (
    export_project
)


# =========================================================
# MAIN PIPELINE
# =========================================================


def run_business_pipeline(
    prompt
):


    started_at = (
        datetime.now()
        .isoformat()
    )


    print()

    print("========================================")

    print(
        "[BUSINESS ORCHESTRATOR START]"
    )

    print("========================================")

    print()

    print("[PROMPT]")

    print(
        prompt
    )


    stages = {}


    # =====================================================
    # STAGE 1
    # BUSINESS GENERATION
    # =====================================================


    print()

    print(
        "[ORCHESTRATOR]"
        " STARTING BUSINESS GENERATOR"
    )


    project_result = (
        create_business_project(
            prompt
        )
    )


    # =====================================================
    # GET PROJECT PATH
    # =====================================================


    if isinstance(
        project_result,
        dict
    ):

        project_path = (

            project_result.get(
                "project"
            )

            or

            project_result.get(
                "path"
            )

        )


    else:

        project_path = (
            project_result
        )


    stages[
        "generation"
    ] = {

        "status":
            "COMPLETED",

        "project":
            project_path

    }


    # =====================================================
    # STAGE 2
    # VALIDATION
    # =====================================================


    print()

    print(
        "[ORCHESTRATOR]"
        " STARTING VALIDATION"
    )


    validation = (
        validate_project(
            project_path
        )
    )


    stages[
        "validation"
    ] = validation


    # =====================================================
    # STAGE 3
    # PROJECT REGISTRATION
    # =====================================================


    print()

    print(
        "[ORCHESTRATOR]"
        " REGISTERING PROJECT"
    )


    registration = (
        register_project(

            project_path,

            status=(
                validation.get(
                    "status"
                )
            ),

            score=(
                validation.get(
                    "score"
                )
            )

        )
    )


    stages[
        "registration"
    ] = registration


    # =====================================================
    # STAGE 4
    # EXPORT
    # =====================================================


    print()

    print(
        "[ORCHESTRATOR]"
        " EXPORTING PROJECT"
    )


    export = (
        export_project(
            project_path
        )
    )


    stages[
        "export"
    ] = export


    # =====================================================
    # FINAL RESULT
    # =====================================================


    finished_at = (
        datetime.now()
        .isoformat()
    )


    final_status = (

        validation.get(
            "status",
            "UNKNOWN"
        )

    )


    result = {

        "status":
            final_status,

        "prompt":
            prompt,

        "project":
            project_path,

        "score":
            validation.get(
                "score"
            ),

        "stages":
            stages,

        "started_at":
            started_at,

        "finished_at":
            finished_at

    }


    print()

    print("========================================")

    print(
        "[BUSINESS ORCHESTRATOR FINISHED]"
    )

    print("========================================")

    print()

    print(
        "STATUS:",
        final_status
    )

    print(
        "PROJECT:",
        project_path
    )

    print(
        "SCORE:",
        validation.get(
            "score"
        )
    )


    return result
