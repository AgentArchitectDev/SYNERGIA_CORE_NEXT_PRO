# =========================================================
# CMS STORAGE
# =========================================================


BASE = "projects"



# =========================================================
# CMS PAGE LOAD
# =========================================================


@app.get("/page/{project}/{page}")

def get_page(
    project,
    page
):

    path = (
        f"{BASE}/{project}/pages/{page}.json"
    )


    if not os.path.exists(path):

        return {

            "slug": page,

            "title": page,

            "blocks": []

        }



    with open(path) as f:

        return json.load(f)



# =========================================================
# CMS PAGE SAVE
# =========================================================


@app.post("/page/save")

async def save_page(
    data: dict
):

    project = data["project"]

    page = data["page"]


    os.makedirs(

        f"{BASE}/{project}/pages",

        exist_ok=True

    )


    with open(

        f"{BASE}/{project}/pages/{page['slug']}.json",

        "w"

    ) as f:


        json.dump(

            page,

            f,

            indent=4

        )



    return {

        "status":

        "saved"

    }



